<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="navigation_advanced">高级</string>
    <string name="advanced_diagnostics_title">运行与诊断</string>
    <string name="advanced_intro">通过 Shell 命令控制小窗模式。复制命令后，可用于手势、快捷操作、自动化或终端。</string>
    <string name="advanced_requirements_title">使用前</string>
    <string name="advanced_requirements">在 LSPosed 中启用 NeXtep，并重启设备使模块生效。请在手机解锁后，以 Root 权限执行命令。</string>
    <string name="advanced_commands_title">Shell 命令</string>
    <string name="advanced_toggle_title">切换小窗模式</string>
    <string name="advanced_toggle_summary">已进入则退出，否则进入。请复制完整脚本。</string>
    <string name="advanced_enter_title">进入小窗模式</string>
    <string name="advanced_enter_summary">已处于小窗模式时，保持当前工作区。</string>
    <string name="advanced_exit_title">退出小窗模式</string>
    <string name="advanced_exit_summary">已退出小窗模式时，保持正常模式。</string>
    <string name="advanced_query_title">查询当前状态</string>
    <string name="advanced_query_summary">1：小窗模式；0：正常模式；null：尚无状态记录。</string>
    <string name="advanced_setup_title">配置方法</string>
    <string name="advanced_setup_copy">复制所需命令，粘贴到 Shell 或自定义命令动作中。不要添加 adb shell 前缀。</string>
    <string name="advanced_setup_root">选择 Root 执行方式，并授予执行工具 Root 权限。在手机终端中使用时，先执行 su，再粘贴命令。</string>
    <string name="advanced_setup_bind">将“进入”和“退出”命令分别绑定到手势或快捷操作并保存。</string>
    <string name="advanced_copy">复制</string>
    <string name="advanced_copied">已复制</string>
    <string name="advanced_copy_description">复制%1$s命令</string>
</resources>
