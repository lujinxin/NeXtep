<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="navigation_advanced">進階</string>
    <string name="advanced_diagnostics_title">執行狀態與診斷</string>
    <string name="advanced_intro">透過 Shell 命令控制小窗模式。複製命令後，可用於手勢、快捷操作、自動化或終端機。</string>
    <string name="advanced_requirements_title">使用前</string>
    <string name="advanced_requirements">在 LSPosed 中啟用 NeXtep，並重新啟動裝置使模組生效。請在手機解鎖後，以 Root 權限執行命令。</string>
    <string name="advanced_commands_title">Shell 命令</string>
    <string name="advanced_toggle_title">切換小窗模式</string>
    <string name="advanced_toggle_summary">已進入則退出，否則進入。請複製完整指令碼。</string>
    <string name="advanced_enter_title">進入小窗模式</string>
    <string name="advanced_enter_summary">已處於小窗模式時，保留目前工作區。</string>
    <string name="advanced_exit_title">退出小窗模式</string>
    <string name="advanced_exit_summary">已退出小窗模式時，維持一般模式。</string>
    <string name="advanced_query_title">查詢目前狀態</string>
    <string name="advanced_query_summary">1：小窗模式；0：一般模式；null：尚無狀態記錄。</string>
    <string name="advanced_setup_title">設定方法</string>
    <string name="advanced_setup_copy">複製所需命令，貼到 Shell 或自訂命令動作中。不要加上 adb shell 前綴。</string>
    <string name="advanced_setup_root">選擇 Root 執行方式，並授予執行工具 Root 權限。在手機終端機中使用時，先執行 su，再貼上命令。</string>
    <string name="advanced_setup_bind">將「進入」和「退出」命令分別綁定至手勢或快捷操作並儲存。</string>
    <string name="advanced_copy">複製</string>
    <string name="advanced_copied">已複製</string>
    <string name="advanced_copy_description">複製%1$s命令</string>
</resources>
